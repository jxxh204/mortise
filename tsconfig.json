{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals",
      "@vitejs/plugin-rsc/types",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@mortise/core": [
        "packages/core/src/index.ts"
      ],
      "@mortise/react": [
        "packages/react/src/index.tsx"
      ],
      "@mortise/vite-plugin": [
        "packages/vite-plugin/src/index.ts"
      ],
      "@mortise/server": [
        "packages/server/src/index.ts"
      ],
      "@mortise/server/node": [
        "packages/server/src/node.ts"
      ],
      "@mortise/rsc/server": [
        "packages/rsc/src/server.ts"
      ],
      "@mortise/rsc/client": [
        "packages/rsc/src/client.tsx"
      ]
    }
  },
  "include": [
    "packages",
    "examples",
    "vitest.config.ts",
    "examples/playground/.mortise/**/*.d.ts",
    "examples/rsc/.mortise/**/*.d.ts"
  ]
}
